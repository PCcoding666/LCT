<Window x:Class="LiveCaptionsTranslator.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LCT — History" Width="760" Height="540" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{StaticResource HudBackground}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="// history" Style="{StaticResource MonoAccent}" FontSize="14" />
            <TextBlock Text="{Binding CountText}" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding EnabledText}" Style="{StaticResource Caption}" Margin="0,6,0,10" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" KeyDown="Search_KeyDown" ToolTip="Search source and translated text" />
            <Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}" Margin="8,0,0,0" />
        </Grid>
        <ListBox Grid.Row="3" ItemsSource="{Binding Entries}" Margin="0,10,0,0" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Timestamp, StringFormat=MM-dd HH:mm:ss}" Style="{StaticResource MonoSmall}" />
                            <TextBlock Text="{Binding Source}" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{Binding Source, Converter={StaticResource SourceToBrush}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding TranslatedText}" FontSize="14" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource GhostButton}" Content="⧉" ToolTip="Copy" Click="Copy_Click" Tag="{Binding}" />
                            <Button Style="{StaticResource GhostButton}" Content="🗑" ToolTip="Delete this entry"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Export CSV…" Click="ExportCsv_Click" Margin="8,0,0,0" />
                <Button Content="Clear All" Style="{StaticResource DangerButton}" Click="ClearAll_Click" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

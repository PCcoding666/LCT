<Window x:Class="LiveCaptionsTranslator.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to LCT" Width="680" Height="560" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen" Background="{StaticResource HudBackground}"
        Icon="pack://application:,,,/images/LCT_logo.ico">
    <Window.Resources>
        <Style x:Key="StepDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Fill" Value="{StaticResource HudHairlineStrong}" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource HudTextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Field" TargetType="Grid">
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </Window.Resources>
    <Grid Margin="28,22,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <StackPanel>
                <TextBlock Text="LCT for Windows" Style="{StaticResource MonoAccent}" FontSize="12" />
                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Title}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0">
                <Ellipse Style="{StaticResource StepDot}" />
                <Ellipse Style="{StaticResource StepDot}" />
                <Ellipse Style="{StaticResource StepDot}" />
                <Ellipse Style="{StaticResource StepDot}" />
                <Ellipse Style="{StaticResource StepDot}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
            <Grid>
                <!-- Welcome -->
                <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Body}" Text="Real-time captions and translation, entirely on this PC. LCT listens to what your PC plays and to your microphone, recognizes speech with whisper.cpp, and translates with a local Ollama model. Nothing leaves your machine." />
                    <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="❯ Captions for videos, calls and meetings — no Live Captions required, works on Windows 10 and 11" Margin="0,4" />
                            <TextBlock Text="❯ Two channels: system audio and microphone, each with its own language" Margin="0,4" />
                            <TextBlock Text="❯ Streaming translation with live drafts while people speak" Margin="0,4" />
                            <TextBlock Text="❯ Floating overlay, tray icon and global hotkeys" Margin="0,4" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0" Text="{Binding HardwareText, StringFormat=This PC: {0}}" />
                </StackPanel>

                <!-- Devices & languages -->
                <StackPanel Visibility="{Binding IsDevices, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Body}" Text="Choose what LCT listens to. System audio needs no permission. The microphone uses the Windows microphone privacy setting — if Windows blocks desktop apps, LCT will tell you when you start." />
                    <CheckBox Content="Capture system audio (recommended)" IsChecked="{Binding CaptureSystemAudio}" />
                    <CheckBox Content="Capture microphone" IsChecked="{Binding CaptureMicrophone}" />
                    <Grid Style="{StaticResource Field}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Microphone device" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding InputDevices}" SelectedItem="{Binding MicrophoneDevice}" DisplayMemberPath="Label" />
                    </Grid>
                    <Grid Style="{StaticResource Field}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Spoken language" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SourceLanguages}" SelectedValue="{Binding SourceLanguage}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                    </Grid>
                    <Grid Style="{StaticResource Field}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Translate to" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding TargetLanguages}" SelectedValue="{Binding TargetLanguage}" SelectedValuePath="Value" DisplayMemberPath="Label" />
                    </Grid>
                    <Button Content="Open Windows microphone privacy settings" Style="{StaticResource LinkButton}" Command="{Binding OpenMicrophonePrivacyCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Checking -->
                <StackPanel Visibility="{Binding IsCheckingOllama, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Body}" Text="{Binding StatusMessage}" />
                    <ProgressBar IsIndeterminate="True" />
                </StackPanel>

                <!-- Not installed -->
                <StackPanel Visibility="{Binding IsOllamaNotInstalled, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Body}" Text="LCT translates with Ollama, a free local model runtime. Install it on this PC, or connect LCT to an Ollama server you already run." />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Install Ollama for Windows" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8" Text="Download it from ollama.com, run the installer, then come back and click Check Again. LCT uses the Ollama you install and never stops it." />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Open ollama.com/download" Style="{StaticResource AccentButton}" Command="{Binding OpenDownloadPageCommand}" />
                                <Button Content="Check Again" Command="{Binding CheckAgainCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="{Binding ShowIpexOption, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Intel GPU detected" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8" Text="Optional: LCT can download the IPEX-LLM build of Ollama, which runs models on Intel Arc / Iris GPUs. It is installed privately under %LOCALAPPDATA%\LCT and only used when no other Ollama is present." />
                            <Button Content="Install Intel GPU build (≈ 1 GB)" Command="{Binding InstallIpexCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                    <Button Content="Use a remote Ollama server instead…" Style="{StaticResource LinkButton}" Command="{Binding UseRemoteCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Caption}" Foreground="{StaticResource HudOrange}" Margin="0,10,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Remote -->
                <StackPanel Visibility="{Binding IsRemoteOllama, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Body}" Text="Connect to an Ollama API that already has the translation model installed. Remote servers are contacted over HTTPS only." />
                    <Grid Style="{StaticResource Field}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Host" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding RemoteHost, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="12,0" />
                        <TextBox Grid.Column="3" Text="{Binding RemotePort, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Style="{StaticResource Field}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Model" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding RemoteModel, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Text="LCT will verify /api/tags and save this endpoint if the model is present." />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Connect &amp; Save" Style="{StaticResource AccentButton}" Command="{Binding SaveRemoteCommand}" />
                        <Button Content="Back" Command="{Binding BackCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Caption}" Foreground="{StaticResource HudOrange}" Margin="0,10,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Model missing -->
                <StackPanel Visibility="{Binding IsModelMissing, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Body}" Text="Ollama is running, but no translation model is installed yet." />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding HardwareText, StringFormat=Recommended for this PC ({0}):}" />
                    <ComboBox ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="DisplayName" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding RecommendationReason}" Margin="0,6,0,0" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="DOWNLOAD SIZE" Style="{StaticResource MonoSmall}" />
                            <TextBlock Text="{Binding SelectedModelSize}" Style="{StaticResource Mono}" Foreground="{StaticResource HudText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="OR RUN IN A TERMINAL" Style="{StaticResource MonoSmall}" />
                            <TextBlock Text="{Binding PullCommandText}" Style="{StaticResource Mono}" Foreground="{StaticResource HudText}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Download" Style="{StaticResource AccentButton}" Command="{Binding DownloadModelCommand}" MinWidth="110" />
                        <Button Content="Check Again" Command="{Binding CheckAgainCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Caption}" Foreground="{StaticResource HudOrange}" Margin="0,10,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Downloading -->
                <StackPanel Visibility="{Binding IsDownloadingModel, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Body}" Text="{Binding ProgressText}" Visibility="{Binding ModelManager.IsPulling, Converter={StaticResource InverseBoolToVis}}" />
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Visibility="{Binding ModelManager.IsPulling, Converter={StaticResource InverseBoolToVis}}" />
                    <StackPanel Visibility="{Binding ModelManager.IsPulling, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Body}" Text="{Binding ModelManager.CurrentModel, StringFormat=Downloading {0}…}" />
                        <ProgressBar Value="{Binding ModelManager.Progress, Mode=OneWay}" Maximum="1" />
                        <TextBlock Text="{Binding ModelManager.ProgressText}" Style="{StaticResource Mono}" Margin="0,8,0,0" />
                    </StackPanel>
                    <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>

                <!-- Speech model -->
                <StackPanel Visibility="{Binding IsSpeechModel, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding ReadyModelName, Converter={StaticResource StringToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" Style="{StaticResource MonoAccent}" FontSize="14" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding ReadyModelName, StringFormat=Translation model {0} is ready}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Body}" Text="{Binding WhisperText}" />
                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" />
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Mono}" Margin="0,8,0,0" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Caption}" Foreground="{StaticResource HudOrange}" Margin="0,10,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Complete -->
                <StackPanel Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Body}" Text="Everything is in place. Press start in the main window — or Ctrl+Alt+S from anywhere — and play some audio." />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding ReadyModelName, StringFormat=✓ Translation model: {0}}" Margin="0,3" />
                            <TextBlock Text="{Binding Settings.WhisperModel, StringFormat=✓ Speech model: whisper {0}}" Margin="0,3" />
                            <TextBlock Text="✓ Settings saved to %LOCALAPPDATA%\LCT\settings.json" Margin="0,3" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0" Text="Ctrl+Alt+S start/stop · Ctrl+Alt+P pause · Ctrl+Alt+O overlay · the tray icon keeps LCT running when the window is closed." />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Back" Command="{Binding BackCommand}" HorizontalAlignment="Left" Visibility="{Binding ShowNext, Converter={StaticResource BoolToVis}}" />
            <Button Content="{Binding NextText}" Style="{StaticResource AccentButton}" Command="{Binding NextCommand}" HorizontalAlignment="Right" MinWidth="140"
                    Visibility="{Binding ShowNext, Converter={StaticResource BoolToVis}}" />
            <Button Content="Start using LCT" Style="{StaticResource AccentButton}" Command="{Binding FinishCommand}" HorizontalAlignment="Right" MinWidth="140"
                    Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</Window>

<Window x:Class="LiveCaptionsTranslator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LiveCaptionsTranslator.Controls"
        xmlns:v="clr-namespace:LiveCaptionsTranslator.Views"
        Title="LCT" Width="840" Height="580" MinWidth="520" MinHeight="400"
        Icon="pack://application:,,,/images/LCT_logo.ico"
        Background="{StaticResource HudBackground}">
    <Window.Resources>
        <v:NoticeActionLabelConverter x:Key="NoticeLabel" />
        <Style x:Key="Cursor" TargetType="Rectangle">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Fill" Value="{StaticResource HudAccent}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.9" To="0.15" Duration="0:0:0.5" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="30" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== HUD bar ===== -->
        <Grid Grid.Row="0" Margin="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                    <Ellipse.Fill>
                        <MultiBinding Converter="{StaticResource CaptureStateToBrush}">
                            <Binding Path="CaptureState" />
                            <Binding Path="IsPaused" />
                        </MultiBinding>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Mono}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="LanguageButton" Style="{StaticResource GhostButton}" Click="LanguageButton_Click" ToolTip="Recognition and translation languages — applies live while capturing">
                    <TextBlock Text="{Binding LanguageLabelText}" Style="{StaticResource Mono}" />
                </Button>
                <Button Style="{StaticResource GhostButton}" Click="OllamaIndicator_Click" ToolTip="{Binding OllamaStatusText}" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{Binding OllamaUp, Converter={StaticResource OllamaDotBrush}}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OllamaStatusText}" Style="{StaticResource Mono}" Margin="6,0,0,0" Visibility="{Binding OllamaUp, Converter={StaticResource InverseBoolToVis}}" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding ModelName}" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="{Binding ModelStateDetail}" />
                <TextBlock Text="loading…" Style="{StaticResource MonoSmall}" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="{Binding ModelIsLoading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding LatencyText}" Style="{StaticResource Mono}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{Binding IsTranslating, Converter={StaticResource ActiveTextBrush}}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ToggleButton x:Name="AutoScrollToggle" IsChecked="True" Content="⤓" FontSize="14" Padding="6,1" Background="Transparent" BorderBrush="Transparent" ToolTip="Auto-scroll" Checked="AutoScroll_Changed" Unchecked="AutoScroll_Changed" />
                <Button Style="{StaticResource ToolbarButton}" Content="⟲" ToolTip="History" Click="History_Click" />
                <Button x:Name="ExportButton" Style="{StaticResource ToolbarButton}" Content="⇪" ToolTip="Export this session" Click="Export_Click" IsEnabled="{Binding HasTranscript}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Export as Markdown…" Click="ExportMarkdown_Click" />
                            <MenuItem Header="Export as Text…" Click="ExportText_Click" />
                            <MenuItem Header="Export as Subtitles (SRT)…" Click="ExportSrt_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Content="⚙" ToolTip="Settings" Click="Settings_Click" />
            </StackPanel>
        </Grid>
        <Rectangle Grid.Row="1" Style="{StaticResource Hairline}" />

        <!-- ===== Notice banner ===== -->
        <Border Grid.Row="2" Margin="16,10,16,0" Padding="12,10" CornerRadius="8" Background="{StaticResource HudSurfaceRaised}" BorderThickness="1"
                BorderBrush="{Binding Notice.Severity, Converter={StaticResource SeverityToBrush}}"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{Binding Notice.Severity, Converter={StaticResource SeverityToBrush}}" Margin="0,0,10,0" Grid.RowSpan="2" />
                <TextBlock Grid.Column="1" Text="{Binding Notice.Message}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="✕" FontSize="11" Click="DismissNotice_Click" VerticalAlignment="Top" />
                <ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Notice.Actions}" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Converter={StaticResource NoticeLabel}}" Margin="6,0,0,0" Padding="10,4"
                                    Command="{Binding NoticeActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ===== Transcript feed ===== -->
        <Grid Grid.Row="3">
            <ScrollViewer x:Name="FeedScroll" VerticalScrollBarVisibility="Auto" Padding="20,16" ScrollChanged="FeedScroll_ScrollChanged">
                <StackPanel>
                    <StackPanel Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}" Margin="0,24,0,0">
                        <StackPanel Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ListeningText}" Style="{StaticResource Mono}" FontSize="13" />
                            <TextBlock Text="// speak or play audio — captions appear here" Style="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource HudTextTertiary}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsCapturing, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="// no transcriptions yet" Style="{StaticResource Mono}" FontSize="13" />
                            <TextBlock Text="// press Ctrl+Alt+S or hit start to begin capturing" Style="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource HudTextTertiary}" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Segments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,3,0,0">
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource MonoSmall}" />
                                        <TextBlock Text="{Binding SourceLabel}" FontFamily="{StaticResource MonoFont}" FontSize="9" FontWeight="SemiBold" Margin="0,2,0,0"
                                                   Foreground="{Binding Source, Converter={StaticResource SourceToBrush}}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" BorderThickness="2,0,0,0" BorderBrush="{Binding State, Converter={StaticResource SegmentBorderBrush}}" Padding="14,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Caption}" FontSize="12.5" Visibility="{Binding SourceText, Converter={StaticResource StringToVis}}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding HasTranslation, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding TranslatedText}" FontSize="15" FontWeight="Medium" MaxWidth="900" />
                                                <Rectangle Style="{StaticResource Cursor}" Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBlock Text="streaming…" Style="{StaticResource MonoSmall}" Foreground="{StaticResource HudAccentDim}" Margin="0,4,0,0" Visibility="{Binding ShowStreamingHint, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="paused — translates on resume" Style="{StaticResource MonoSmall}" Foreground="{StaticResource HudOrange}" Margin="0,4,0,0" Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding TranslatedText}" Style="{StaticResource MonoSmall}" Foreground="{StaticResource HudRed}" Margin="0,4,0,0" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Live draft -->
                    <Border Style="{StaticResource Card}" Padding="14,10" Visibility="{Binding HasLiveDraft, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❯" Style="{StaticResource MonoAccent}" FontSize="13" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <TextBlock Text="{Binding LiveSourceText}" Style="{StaticResource Caption}" FontSize="13" MaxWidth="900" />
                                <Rectangle Style="{StaticResource Cursor}" Visibility="{Binding HasLiveTranslation, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasLiveTranslation, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="↳" Style="{StaticResource Mono}" Foreground="{StaticResource HudAccentDim}" FontSize="13" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <TextBlock Text="{Binding LiveTranslation}" FontSize="15" FontWeight="Medium" Opacity="0.85" MaxWidth="900" />
                                <Rectangle Style="{StaticResource Cursor}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Button x:Name="LatestButton" Content="⤓ latest" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,12" Visibility="Collapsed" Click="Latest_Click" />
        </Grid>

        <Rectangle Grid.Row="4" Style="{StaticResource Hairline}" />

        <!-- ===== Bottom bar ===== -->
        <Grid Grid.Row="5" Margin="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <c:LaneMeter Label="SYS" Level="{Binding SystemLevel}" IsActive="{Binding MetersActive}" Tint="{StaticResource HudCyan}" />
                <c:LaneMeter Label="MIC" Level="{Binding MicLevel}" IsActive="{Binding MetersActive}" Tint="{StaticResource HudOrange}" DeviceName="{Binding MicrophoneDeviceName}" Margin="0,3,0,0"
                             Visibility="{Binding ShowMicMeter, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding HintText}" Style="{StaticResource MonoSmall}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🗑" ToolTip="Clear transcript" Click="Clear_Click" IsEnabled="{Binding IsIdle}" Padding="9,5" />
                <Button x:Name="PauseButton" Content="⏸" ToolTip="Pause (Ctrl+Alt+P)" Click="Pause_Click" IsEnabled="{Binding IsCapturing}" Margin="8,0,0,0" Padding="9,5" MinWidth="36" />
                <Button Style="{StaticResource AccentButton}" Content="{Binding CaptureButtonText}" Click="Capture_Click" MinWidth="88" Margin="8,0,0,0"
                        Visibility="{Binding IsCapturing, Converter={StaticResource InverseBoolToVis}}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                <Button Style="{StaticResource DangerButton}" Content="{Binding CaptureButtonText}" Click="Capture_Click" MinWidth="88" Margin="8,0,0,0"
                        Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
		<!-- Windows 10 1809 and later: WASAPI loopback, tray and hotkeys all work there. -->
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>12</LangVersion>
		<UseWPF>true</UseWPF>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<RootNamespace>LiveCaptionsTranslator</RootNamespace>
		<!-- The assembly name is part of the installer and release contract: keep it. -->
		<AssemblyName>LiveCaptionsTranslator</AssemblyName>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>

		<!--
		  Version management. <VersionPrefix> is the single source of truth: a release
		  tag vX.Y.Z must equal it (enforced by .github/workflows/windows-build.yml).
		  Local builds get the "-dev" suffix; CI passes VersionSuffix=ci.N for branch
		  builds and ReleaseBuild=true for tagged releases. Assembly attributes are
		  generated from these properties, so never hand-edit version numbers in
		  src/AssemblyInfo.cs.
		-->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<VersionPrefix Condition="'$(VersionPrefix)' == ''">2.0.0</VersionPrefix>
		<VersionSuffix Condition="'$(VersionSuffix)' == '' And '$(ReleaseBuild)' != 'true'">dev</VersionSuffix>
		<AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(VersionPrefix).0</AssemblyVersion>
		<FileVersion Condition="'$(FileVersion)' == ''">$(VersionPrefix).0</FileVersion>
		<AssemblyTitle>LCT (LiveCaptions Translator)</AssemblyTitle>
		<Product>LCT (LiveCaptions Translator)</Product>
		<Title>LCT (LiveCaptions Translator)</Title>
		<Description>Real-time captions and translation: on-device speech recognition, local Ollama translation</Description>
		<Company>Ai-All-You-Need-Platform Pte. Ltd.</Company>
		<Authors>Ai-All-You-Need-Platform Pte. Ltd.</Authors>
		<Copyright>Copyright © 2024-2026 Ai-All-You-Need-Platform Pte. Ltd.</Copyright>
		<ApplicationIcon>images\LCT_logo.ico</ApplicationIcon>

		<!-- Publish defaults; the workflow overrides per variant. -->
		<PublishReadyToRun>true</PublishReadyToRun>
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<DebugType>embedded</DebugType>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<Platforms>AnyCPU;ARM64</Platforms>
	</PropertyGroup>

	<!-- LCT.Core and the tests live under this folder but are separate projects. -->
	<ItemGroup>
		<Compile Remove="src\LCT.Core\**;Tests\**" />
		<None Remove="src\LCT.Core\**;Tests\**" />
		<Page Remove="src\LCT.Core\**;Tests\**" />
		<EmbeddedResource Remove="src\LCT.Core\**;Tests\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="src\LCT.Core\LCT.Core.csproj" />
	</ItemGroup>

	<!-- The WPF SDK's implicit usings leave these out. -->
	<ItemGroup>
		<Using Include="System.IO" />
		<Using Include="System.Net.Http" />
	</ItemGroup>

	<ItemGroup>
		<ApplicationDefinition Include="src\App.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</ApplicationDefinition>
		<Resource Include="images\LCT_logo.ico" />
		<Resource Include="images\LCT_logo.png" />

		<!-- Audio capture -->
		<PackageReference Include="NAudio" Version="2.2.1" />
		<PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
		<!-- On-device speech recognition (whisper.cpp) -->
		<PackageReference Include="Whisper.net" Version="1.9.1" />
		<PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
		<!-- Tray icon -->
		<PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
		<!-- Hardware detection (WMI) -->
		<PackageReference Include="System.Management" Version="8.0.0" />
		<!-- Logging -->
		<PackageReference Include="Serilog" Version="4.3.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="8.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- Build provenance, read by AppInfo.cs. CI passes the values; local builds leave them out. -->
		<AssemblyMetadata Include="GitCommitHash" Value="$(GitCommitHash)" Condition="'$(GitCommitHash)' != ''" />
		<AssemblyMetadata Include="BuildTimestamp" Value="$(BuildTimestamp)" Condition="'$(BuildTimestamp)' != ''" />
		<AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)" />
	</ItemGroup>

</Project>
